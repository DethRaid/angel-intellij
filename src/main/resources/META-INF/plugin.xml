<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.sarahshandcraftedentertainment.angelintellij</id>
    <name>AngelScript</name>
    <vendor url="https://sarahshandcraftedentertainment.com">sarah's handcrafted entertainment</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <!--FIXME    <resource-bundle>messages.MyBundle</resource-bundle>-->

    <extensions defaultExtensionNs="com.intellij">
        <!--FIXME        <toolWindow factoryClass="toolWindow.com.sarahshandcraftedentertainment.angelintellij.MyToolWindowFactory" id="MyToolWindow"/>-->

        <postStartupActivity implementation="com.sarahshandcraftedentertainment.angelintellij.ValidationStartupActivity"/>

        <fileType
                name="AngelScript"
                implementationClass="com.sarahshandcraftedentertainment.angelintellij.language.AngelScriptFileType"
                fieldName="INSTANCE"
                language="angelscript"
                extensions="as"/>

        <fileType
                name="AngelScript Predefined"
                implementationClass="com.sarahshandcraftedentertainment.angelintellij.language.AngelScriptPredefinedFileType"
                fieldName="INSTANCE"
                language="angelscript-predefined"
                extensions="predefined"/>

        <lang.braceMatcher language="angelscript"
                           implementationClass="com.sarahshandcraftedentertainment.angelintellij.editor.AngelScriptBraceMatcher"/>

        <lang.parserDefinition language="angelscript"
                               implementationClass="com.sarahshandcraftedentertainment.angelintellij.language.AngelScriptParserDefinition"/>

        <lang.syntaxHighlighterFactory language="angelscript"
                                       implementationClass="com.sarahshandcraftedentertainment.angelintellij.editor.AngelScriptSyntaxHighlighterFactory"/>

        <!--        <lang.quoteHandler language="AngelScript"-->
        <!--                           implementationClass="com.sarahshandcraftedentertainment.angelintellij.editor.AngelScriptQuoteHandler"/>-->
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="angelScriptLanguageServer"
                name="AngelScript Language Server"
                factoryClass="com.sarahshandcraftedentertainment.angelintellij.lsp.AngelScriptLanguageServerFactory">
            <description><![CDATA[
            AngelScript Language Server (Preview)
            ]]>
            </description>
        </server>

        <semanticTokensColorsProvider
                serverId="angelScriptLanguageServer"
                class="com.sarahshandcraftedentertainment.angelintellij.lsp.AngelScriptSemanticTokensColorProvider"/>

        <fileNamePatternMapping patterns="*.as;as.predefined"
                                serverId="angelScriptLanguageServer"
                                languageId="angelscript"/>
    </extensions>

    <actions>
        <!-- Reuse VS Code action ids while waiting for standardization of LSP commands https://github.com/microsoft/language-server-protocol/issues/788 -->
<!--        <action id="editor.action.triggerParameterHints"-->
<!--                class="action.lsp.com.sarahshandcraftedentertainment.angelintellij.TriggerParameterHintsAction"/>-->

<!--        <action id="editor.action.triggerSuggest"-->
<!--                class="com.sarahshandcraftedentertainment.angelintellij.lsp.action.TriggerSuggestAction"/>-->

    </actions>

    <applicationListeners>
        <!--FIXME        <listener class="listeners.com.sarahshandcraftedentertainment.angelintellij.MyApplicationActivationListener"-->
        <!--FIXME                  topic="com.intellij.openapi.application.ApplicationActivationListener"/>-->
    </applicationListeners>
</idea-plugin>
